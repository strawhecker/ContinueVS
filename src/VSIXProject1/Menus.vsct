<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Commands package="guidContinueVSPackage">

	<!-- Define the tool window command explicitly -->
	<Groups>
	  <Group guid="guidContinueVSCmdSet" id="idShowContinuePanelGroup" priority="0x0600" />
	</Groups>

	<Buttons>
	  <Button guid="guidContinueVSCmdSet" id="idShowContinuePanel" priority="0x0100" type="Button">
		<Parent guid="guidSHLMainMenu" id="IDG_VS_TOOLS_EXT_TOOLS" />
		<Strings>
		  <ButtonText>Continue</ButtonText>
		  <LocCanonicalName>ContinueVS.ShowContinuePanel</LocCanonicalName>
		</Strings>
	  </Button>
	</Buttons>

	<KeyBindings>
	  <KeyBinding guid="guidContinueVSCmdSet" id="idShowContinuePanel" editor="guidVSStd97" key1="J" mod1="Control Shift" />
	</KeyBindings>

  </Commands>

  <SymbolDefinitions>
	<GuidSymbol name="guidContinueVSPackage" value="a4507790-4510-4158-b192-87339e7b1a34" />
	<GuidSymbol name="guidContinueVSCmdSet" value="6b8f0a3c-2d4e-4f1a-9e5b-3c7d8a1f2b0e">
	  <IDSymbol name="idShowContinuePanelGroup" value="0x1020" />
	  <IDSymbol name="idShowContinuePanel" value="0x0100" />
	</GuidSymbol>
	<GuidSymbol name="guidSHLMainMenu" value="d309f791-863f-11d8-832e-00a0c91110c9">
	  <IDSymbol name="IDG_VS_TOOLS_EXT_TOOLS" value="4150" />
	</GuidSymbol>
