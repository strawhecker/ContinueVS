<UserControl x:Class="ContinueVS.UI.Pages.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ContinueVS.UI.Views"
             xmlns:converters="clr-namespace:ContinueVS.ViewModels.Converters"
             xmlns:local="clr-namespace:ContinueVS.UI.Pages">
    <UserControl.Resources>
        <converters:ChatModeToVisibilityConverter x:Key="ChatModeToVisibilityConverter"/>
        <converters:ChatModeToBoolConverter x:Key="ChatModeToBoolConverter"/>
        <local:ChatMessageTemplateSelector x:Key="MessageTemplateSelector">
            <local:ChatMessageTemplateSelector.UserMessageTemplate>
                <DataTemplate>
                    <controls:ChatMessageControl DataContext="{Binding}"/>
                </DataTemplate>
            </local:ChatMessageTemplateSelector.UserMessageTemplate>
            <local:ChatMessageTemplateSelector.AssistantMessageTemplate>
                <DataTemplate>
                    <controls:ChatMessageControl DataContext="{Binding}"/>
                </DataTemplate>
            </local:ChatMessageTemplateSelector.AssistantMessageTemplate>
            <local:ChatMessageTemplateSelector.ToolInvocationTemplate>
                <DataTemplate>
                    <Border BorderBrush="Orange" BorderThickness="1" CornerRadius="4" Margin="5" Padding="8" Background="#FFF9F0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Tool: " FontWeight="Bold" Foreground="#FF6600"/>
                                <TextBlock Text="{Binding Content}" FontWeight="Bold" Foreground="#FF6600"/>
                                <TextBlock Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}[{0}]">
                                            <Binding Path="InvocationStatus"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="#444444"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </local:ChatMessageTemplateSelector.ToolInvocationTemplate>
            <local:ChatMessageTemplateSelector.SystemMessageTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Margin="5" Padding="5" Background="#F0F0F0">
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="#666666" FontSize="11"/>
                    </Border>
                </DataTemplate>
            </local:ChatMessageTemplateSelector.SystemMessageTemplate>
        </local:ChatMessageTemplateSelector>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Context Panel -->
        <Expander Grid.Row="0" Header="Context" IsExpanded="False" Margin="5">
            <ItemsControl ItemsSource="{Binding SelectedContext}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:ContextItemControl DataContext="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <!-- Mode Selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
            <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ToggleButton Content="Ask" IsChecked="{Binding CurrentMode, Mode=TwoWay, Converter={StaticResource ChatModeToBoolConverter}, ConverterParameter=Ask}" Padding="8" Margin="0,0,5,0"/>
            <ToggleButton Content="Agent" IsChecked="{Binding CurrentMode, Mode=TwoWay, Converter={StaticResource ChatModeToBoolConverter}, ConverterParameter=Agent}" Padding="8" Margin="0,0,5,0"/>
            <ToggleButton Content="Plan" IsChecked="{Binding CurrentMode, Mode=TwoWay, Converter={StaticResource ChatModeToBoolConverter}, ConverterParameter=Plan}" Padding="8" Margin="0,0,5,0"/>

            <Separator Width="1" Margin="10,0" Background="LightGray"/>

            <TextBlock Text="Model:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" DisplayMemberPath="Name" Width="200" Margin="0,0,5,0"/>
        </StackPanel>

        <!-- Messages (Chat List) -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Messages}" VerticalAlignment="Stretch" 
                      ItemTemplateSelector="{StaticResource MessageTemplateSelector}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:ChatMessageControl DataContext="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Input Area -->
        <Grid Grid.Row="3" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                     TextWrapping="Wrap" Height="80" Margin="0,0,0,5"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Command="{Binding SendMessageCommand}" 
                        Content="Send" Padding="10" Margin="5,0"/>
                <Button Grid.Column="2" Command="{Binding CancelCommand}" 
                        Content="Cancel" Padding="10" Margin="5,0"/>
                <Button Grid.Column="3" Content="Apply" Padding="10" Margin="5,0"
                        Visibility="{Binding CurrentMode, Converter={StaticResource ChatModeToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
