<UserControl x:Class="ContinueVS.UI.Pages.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ContinueVS.UI.Views"
             xmlns:converters="clr-namespace:ContinueVS.ViewModels.Converters"
             xmlns:local="clr-namespace:ContinueVS.UI.Pages">
    <UserControl.CommandBindings>
        <!-- gap42_2: intercept Paste to log multiline content; e.Handled not set so WPF default paste proceeds -->
        <CommandBinding Command="ApplicationCommands.Paste"
                        PreviewExecuted="InputTextBox_Paste_PreviewExecuted"/>
    </UserControl.CommandBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:ChatModeToVisibilityConverter x:Key="ChatModeToVisibilityConverter"/>
            <converters:ChatModeToBoolConverter x:Key="ChatModeToBoolConverter"/>
            <converters:ToolCallCounterColorConverter x:Key="ToolCallCounterColorConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:ChatMessageTemplateSelector x:Key="MessageTemplateSelector">
            <local:ChatMessageTemplateSelector.UserMessageTemplate>
                <DataTemplate>
                    <controls:ChatMessageControl DataContext="{Binding}"/>
                </DataTemplate>
            </local:ChatMessageTemplateSelector.UserMessageTemplate>
            <local:ChatMessageTemplateSelector.AssistantMessageTemplate>
                <DataTemplate>
                    <controls:ChatMessageControl DataContext="{Binding}"/>
                </DataTemplate>
            </local:ChatMessageTemplateSelector.AssistantMessageTemplate>
            <local:ChatMessageTemplateSelector.ToolInvocationTemplate>
                <DataTemplate>
                    <Border BorderBrush="Orange" BorderThickness="1" CornerRadius="4" Margin="5" Padding="8" Background="{DynamicResource CodeBackground}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Tool: " FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                <TextBlock Text="{Binding Content}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                <TextBlock Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}[{0}]">
                                            <Binding Path="InvocationStatus"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </local:ChatMessageTemplateSelector.ToolInvocationTemplate>
            <local:ChatMessageTemplateSelector.SystemMessageTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Margin="5" Padding="5" Background="{DynamicResource PanelBackground}">
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                    </Border>
                </DataTemplate>
            </local:ChatMessageTemplateSelector.SystemMessageTemplate>
        </local:ChatMessageTemplateSelector>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Warning Banner (80% threshold) - gap23_4_4 -->
        <Border Grid.Row="0" Background="#FFFACD" BorderBrush="#FFD700" BorderThickness="1" Margin="5,5,5,0" Padding="8" Visibility="{Binding ShowWarningBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚠️ Approaching tool call limit (80/100 used). Consider starting a new session soon." TextWrapping="Wrap" Foreground="Black" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" Background="Transparent" BorderThickness="0" Foreground="Black" FontSize="14" Margin="8,0,0,0" Click="DismissWarningBanner_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Error Banner (100% threshold) - gap23_4_4 -->
        <Border Grid.Row="1" Background="#FFB6C6" BorderBrush="#FF0000" BorderThickness="2" Margin="5,5,5,0" Padding="8" Visibility="{Binding ShowErrorBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="❌ Tool call limit reached (100/100). Start a new session to continue." TextWrapping="Wrap" Foreground="DarkRed" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" Background="Transparent" BorderThickness="0" Foreground="DarkRed" FontSize="14" Margin="8,0,0,0" Click="DismissErrorBanner_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Context Panel -->
        <Expander Grid.Row="2" Header="Context" IsExpanded="False" Margin="5" Style="{DynamicResource ThemedExpanderStyle}" Foreground="{DynamicResource PrimaryTextBrush}">
            <ItemsControl ItemsSource="{Binding SelectedContext}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:ContextItemControl DataContext="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <!-- Mode Selector - gap27_1/27_6/27_7 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
            <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedMode, Mode=TwoWay}" Width="120" Margin="0,0,5,0" Style="{DynamicResource ThemedComboBoxStyle}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="14"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="?" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" ToolTip="{Binding SelectedMode.Description, StringFormat='Mode: {0}'}"/>

            <Separator Width="1" Margin="10,0" Background="{DynamicResource BorderBrush}"/>

            <TextBlock Text="Policy:" VerticalAlignment="Center" Margin="5,0,5,0" Foreground="{DynamicResource PrimaryTextBrush}" Visibility="{Binding IsPolicyVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ComboBox ItemsSource="{Binding ContinuationPolicies}" SelectedItem="{Binding SelectedPolicy, Mode=TwoWay}" DisplayMemberPath="Name" Width="160" Height="28" Margin="0,0,5,0" Style="{DynamicResource ThemedComboBoxStyle}" Visibility="{Binding IsPolicyVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Separator Width="1" Margin="10,0" Background="{DynamicResource BorderBrush}"/>

            <TextBlock Text="Model:" VerticalAlignment="Center" Margin="5,0,5,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" DisplayMemberPath="Name" Width="200" Margin="0,0,5,0" Foreground="White" Background="#2D2D30" Style="{DynamicResource ThemedComboBoxStyle}"/>

            <Separator Width="1" Margin="10,0" Background="{DynamicResource BorderBrush}"/>

            <TextBlock Text="{Binding ToolCallCounterDisplay}" VerticalAlignment="Center" Margin="5,0,0,5" FontSize="11" Foreground="{Binding ToolCallCounterDisplay, Converter={StaticResource ToolCallCounterColorConverter}}" ToolTip="Shows cumulative tool calls in current session (resets per-action)"/>

            <Separator Width="1" Margin="10,0" Background="{DynamicResource BorderBrush}"/>

            <!-- gap47: New Chat button starts a fresh session -->
            <Button Command="{Binding NewChatCommand}" Content="➕ New Chat" Padding="8,4" Margin="5,0,0,0" Style="{DynamicResource ThemedButtonStyle}" ToolTip="Start a new chat session"/>
        </StackPanel>

        <!-- Mode Description Helper Text - gap27_6 -->
        <TextBlock Grid.Row="3" Text="{Binding SelectedMode.Description}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" FontStyle="Italic" Margin="5,25,5,0" VerticalAlignment="Top"/>
        <Border Grid.Row="4" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="5" Padding="15" VerticalAlignment="Top" Visibility="{Binding OnboardingCardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="🎯 Getting Started" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Welcome to Continue VS! Here's how to get started:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="• Select a mode (Ask, Agent, or Plan) above" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="• Choose a model from the dropdown" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="• Enter your prompt or question below" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="• Click Send to start the conversation" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                </StackPanel>

                <TextBlock Text="💡 Tip: Switch to Agent mode to let Continue autonomously analyze and edit your code." Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Messages (Chat List) with ScrollViewer -->
        <ScrollViewer Grid.Row="4" x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Messages}" VerticalAlignment="Stretch"
                          ItemTemplateSelector="{StaticResource MessageTemplateSelector}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:ChatMessageControl DataContext="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input Area -->
        <Grid Grid.Row="5" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- gap42_2: AcceptsReturn="True" enables newline preservation on Ctrl+V paste;
                 Enter key is still intercepted by InputTextBox_KeyDown (PreviewKeyDown, e.Handled=true) so no regression -->
            <TextBox x:Name="InputTextBox" Grid.Row="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                     TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False" 
                     MinHeight="80" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,5" Style="{StaticResource DefaultTextBoxStyle}"
                     PreviewKeyDown="InputTextBox_KeyDown"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Command="{Binding SendMessageCommand}" 
                        Content="Send" Padding="10" Margin="5,0" Background="{DynamicResource ButtonPrimaryBrush}" Style="{DynamicResource ThemedButtonStyle}"/>
                <Button Grid.Column="2" Command="{Binding CancelCommand}" 
                        Content="Cancel" Padding="10" Margin="5,0" Background="{DynamicResource ErrorBrush}" Style="{DynamicResource ThemedButtonStyle}"/>
                <Button Grid.Column="3" Command="{Binding PauseCommand}" 
                        Content="{Binding IsPausedDisplay}" Padding="10" Margin="5,0" Background="{DynamicResource ErrorBrush}" 
                        IsEnabled="{Binding IsStreaming}" Style="{DynamicResource ThemedButtonStyle}"/>
                <Button Grid.Column="4" Content="Apply" Padding="10" Margin="5,0" Background="{DynamicResource SuccessBrush}"
                        Visibility="{Binding CurrentMode, Converter={StaticResource ChatModeToVisibilityConverter}}" Style="{DynamicResource ThemedButtonStyle}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
