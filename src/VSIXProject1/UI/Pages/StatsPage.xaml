<UserControl x:Class="ContinueVS.UI.Pages.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding StatsPageViewModel, Mode=OneWay}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Token Usage -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tokens Used:" FontWeight="Bold" Margin="0,0,10,0"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TokensUsed}"/>

        <!-- Models Used -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Models:" FontWeight="Bold" Margin="0,5,10,0"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModelsUsed}" Margin="0,5,0,0"/>

        <!-- Cost Estimate -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cost Estimate:" FontWeight="Bold" Margin="0,5,10,0"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CostEstimate, StringFormat='${0:F2}'}" Margin="0,5,0,0"/>

        <!-- Export Button -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Command="{Binding ExportStatsCommand}" Content="Export Stats" Padding="10"/>
        </StackPanel>
    </Grid>
</UserControl>
