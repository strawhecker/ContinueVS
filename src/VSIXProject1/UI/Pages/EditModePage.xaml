<UserControl x:Class="ContinueVS.UI.Pages.EditModePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding EditModeViewModel, Mode=OneWay}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Code Diff Header -->
        <TextBlock Grid.Row="0" Text="Proposed Changes" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

        <!-- Diff Viewer -->
        <TextBlock Grid.Row="1" Text="{Binding Diff}" TextWrapping="Wrap" 
                   Background="#F5F5F5" Padding="5" Margin="0,0,0,5" 
                   FontFamily="Courier New" FontSize="11"/>

        <!-- Accept/Reject Prompt -->
        <TextBlock Grid.Row="2" Text="Do you want to accept these changes?" Margin="0,0,0,5"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding AcceptCommand}" Content="Accept" Padding="10" Margin="0,0,5,0" Background="Green" Foreground="White"/>
            <Button Command="{Binding RejectCommand}" Content="Reject" Padding="10" Background="Red" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>
