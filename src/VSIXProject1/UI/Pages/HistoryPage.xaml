<UserControl x:Class="ContinueVS.UI.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding HistoryPageViewModel, Mode=OneWay}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" ItemsSource="{Binding Sessions}" 
                 SelectedItem="{Binding SelectedSession, Mode=TwoWay}" Margin="0,0,0,5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CreatedAt}" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding LoadSessionCommand}" Content="Load" Padding="10" Margin="0,0,5,0"/>
            <Button Command="{Binding DeleteSessionCommand}" Content="Delete" Padding="10"/>
        </StackPanel>
    </Grid>
</UserControl>
