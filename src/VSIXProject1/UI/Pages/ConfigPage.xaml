<UserControl x:Class="ContinueVS.UI.Pages.ConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding ConfigPageViewModel, Mode=OneWay}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- Models Tab -->
            <TabItem Header="Models">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" ItemsSource="{Binding AvailableModels}" 
                             SelectedItem="{Binding SelectedModel, Mode=TwoWay}" Margin="0,0,0,5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding AddModelCommand}" Content="Add Model" Padding="10" Margin="0,0,5,0"/>
                        <Button Command="{Binding RemoveModelCommand}" Content="Remove" Padding="10"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tools Tab -->
            <TabItem Header="Tools">
                <Grid Margin="5">
                    <ListBox ItemsSource="{Binding AvailableTools}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" Margin="0,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Profiles Tab -->
            <TabItem Header="Profiles">
                <Grid Margin="5">
                    <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" Margin="0,5,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Command="{Binding SaveConfigCommand}" Content="Save" Padding="10" Margin="0,0,5,0"/>
            <Button Command="{Binding ReindexCommand}" Content="Reindex" Padding="10"/>
        </StackPanel>
    </Grid>
</UserControl>
