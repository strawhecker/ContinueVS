<UserControl x:Class="ContinueVS.UI.Pages.ConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ContinueVS.UI.Pages"
             xmlns:views="clr-namespace:ContinueVS.UI.Views"
             mc:Ignorable="d"
             Loaded="ConfigPage_Loaded"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main TabControl -->
        <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- Tab 1: Models -->
            <TabItem Header="Models">
                <ScrollViewer>
                    <StackPanel Margin="20" VerticalAlignment="Top">
                        <!-- Search FilterBox -->
                        <TextBlock Text="Search Models" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchTextBox"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4"
                                 Margin="0,0,0,0"
                                 Background="White"
                                 BorderThickness="1"
                                 BorderBrush="#DDD"
                                 Foreground="#333"
                                 Height="28"/>

                        <!-- Models ListBox -->
                        <TextBlock Text="Available Models" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ListBox x:Name="ModelsListBox"
                                 ItemsSource="{Binding FilteredModels, Mode=OneWay}"
                                 SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                 Height="200"
                                 BorderThickness="1"
                                 BorderBrush="#DDD"
                                 Margin="0,0,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                        <Run Text=" (" Foreground="#999"/>
                                        <Run Text="{Binding Provider, Mode=OneWay}" Foreground="#999"/>
                                        <Run Text=")" Foreground="#999"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Model Details Pane -->
                        <TextBlock Text="Model Details" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border BorderThickness="1" BorderBrush="#DDD" Padding="12" Background="White" CornerRadius="4" Margin="0,0,0,15" Height="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Name (read-only) -->
                                    <TextBlock Text="Name" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SelectedModel.Name, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Padding="4"
                                         Height="28"
                                         Background="#F5F5F5"
                                         Margin="0,0,0,10"/>

                                    <!-- Provider (read-only) -->
                                    <TextBlock Text="Provider" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SelectedModel.Provider, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Padding="4"
                                         Height="28"
                                         Background="#F5F5F5"
                                         Margin="0,0,0,10"/>

                                    <!-- BaseUrl (read-only) -->
                                    <TextBlock Text="Base URL" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SelectedModel.BaseUrl, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Padding="4"
                                         Height="28"
                                         Background="#F5F5F5"
                                         TextWrapping="Wrap"
                                         Margin="0,0,0,10"/>

                                    <!-- OllamaModelId (read-only if present) -->
                                    <TextBlock Text="Model ID" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SelectedModel.OllamaModelId, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Padding="4"
                                         Height="28"
                                         Background="#F5F5F5"
                                         TextWrapping="Wrap"
                                         Margin="0,0,0,10"/>

                                    <!-- ContextWindow (editable or read-only) -->
                                    <TextBlock Text="Context Window" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ContextWindowTextBox"
                                             Grid.Column="0"
                                             Text="{Binding EditingContextWindow, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Padding="4"
                                             Height="28"
                                             Background="White"
                                             Margin="0,0,8,0"
                                             PreviewTextInput="ContextWindowTextBox_PreviewTextInput"/>
                                        <Button Grid.Column="1"
                                            Content="Update"
                                            Command="{Binding UpdateContextWindowCommand}"
                                            Padding="15,5"
                                            Background="#0078D4"
                                            Foreground="White"
                                            Width="80"/>
                                    </Grid>

                                    <!-- SupportsFunctionCalling (read-only) -->
                                    <TextBlock Text="Supports Function Calling" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <CheckBox IsChecked="{Binding SelectedModel.SupportsFunctionCalling, Mode=OneWay}"
                                          IsEnabled="False"
                                          Margin="0,0,0,10"/>

                                    <!-- SupportedToolFormats (read-only) -->
                                    <TextBlock Text="Supported Tool Formats" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <ItemsControl ItemsSource="{Binding SelectedModel.SupportedToolFormats, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Mode=OneWay}" Margin="0,2,0,0" Foreground="#666"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Fetch from Provider Button (hidden for now) -->
                                    <Button Content="Fetch from Provider"
                                        Visibility="{Binding FetchFromProviderButtonVisibility}"
                                        Padding="15,8"
                                        Background="#6B8E23"
                                        Foreground="White"
                                        Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Add/Remove Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button Content="Add Model"
                                    Command="{Binding AddModelCommand}"
                                    Padding="15,8"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    Margin="0,0,10,0"/>
                            <Button Content="Remove Model"
                                    Command="{Binding RemoveModelCommand}"
                                    Padding="15,8"
                                    Background="#F44336"
                                    Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Tools -->
            <TabItem Header="Tools">
                <StackPanel Margin="20" VerticalAlignment="Top">
                    <TextBlock Text="Available Tools" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Enable/disable tools to control AI assistant capabilities"
                               FontSize="11" Foreground="#666" Margin="0,0,0,10"/>

                    <ScrollViewer Height="300" BorderThickness="1" BorderBrush="#DDD">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding AvailableTools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10" BorderThickness="0,0,0,1" BorderBrush="#EEE">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Checkbox for enable/disable -->
                                                <CheckBox Grid.Column="0"
                                                          x:Name="ToolCheckBox"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Checked="ConfigPage_CheckBox_Checked"
                                                          Unchecked="ConfigPage_CheckBox_Unchecked"
                                                          VerticalAlignment="Top"
                                                          Margin="0,3,10,0"/>

                                                <!-- Tool Info -->
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tool Count Display -->
                    <TextBlock Text="{Binding AvailableTools.Count, StringFormat='Total Tools: {0}'}"
                               Foreground="#666" FontSize="12" Margin="0,10,0,0" FontWeight="Bold"/>
                </StackPanel>
            </TabItem>

            <!-- Tab 3: User Preferences -->
            <TabItem Header="User Preferences">
                <StackPanel Margin="20" VerticalAlignment="Top">
                    <TextBlock Text="User Preferences" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ScrollViewer Height="400" BorderThickness="1" BorderBrush="#DDD" Padding="0">
                        <ContentPresenter Content="{Binding SettingsViewModel}">
                            <ContentPresenter.ContentTemplate>
                                <DataTemplate>
                                    <local:SettingsControl/>
                                </DataTemplate>
                            </ContentPresenter.ContentTemplate>
                        </ContentPresenter>
                    </ScrollViewer>
                </StackPanel>
                 </TabItem>

                <!-- Tab 4: Add Model -->
                <TabItem Header="Add Model">
                    <ScrollViewer>
                        <StackPanel Margin="20" VerticalAlignment="Top">
                            <TextBlock Text="Add New Model" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>
                            <ContentPresenter Content="{Binding AddModelViewModel}">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <views:AddModelDialog DataContext="{Binding}"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

        <!-- Bottom Buttons -->
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="20"
                    Height="50">
            <Button Content="Save Configuration"
                    Command="{Binding SaveConfigCommand}"
                    Padding="15,8"
                    Background="#0078D4"
                    Foreground="White"
                    Margin="0,0,10,0"/>
            <Button Content="Edit Config in Editor"
                    Command="{Binding EditConfigCommand}"
                    Padding="15,8"
                    Background="#6B8E23"
                    Foreground="White"
                    Margin="0,0,10,0"/>
            <Button Content="Reindex Workspace"
                    Command="{Binding ReindexCommand}"
                    Padding="15,8"
                    Background="#7030A0"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>
