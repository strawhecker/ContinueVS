<UserControl x:Class="ContinueVS.UI.Pages.ConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ContinueVS.UI.Pages"
             mc:Ignorable="d"
             Loaded="ConfigPage_Loaded"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="#F3F3F3">
        <StackPanel Margin="20" VerticalAlignment="Top">
            <!-- Title -->
            <TextBlock Text="Configuration" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Models Section -->
            <TextBlock Text="Models" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
            <ComboBox ItemsSource="{Binding AvailableModels}" 
                      SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                      Margin="0,0,0,20"
                      MinHeight="30">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Tools Section -->
            <TextBlock Text="Available Tools" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Enable/disable tools to control AI assistant capabilities" 
                       FontSize="11" Foreground="#666" Margin="0,0,0,10"/>

            <ScrollViewer Height="300" BorderThickness="1" BorderBrush="#DDD">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding AvailableTools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" BorderThickness="0,0,0,1" BorderBrush="#EEE">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox for enable/disable -->
                                        <CheckBox Grid.Column="0" 
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Top"
                                                  Margin="0,3,10,0"/>

                                        <!-- Tool Info -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Tool Count Display -->
            <TextBlock Text="{Binding AvailableTools.Count, StringFormat='Total Enabled Tools: {0}'}" 
                       Foreground="#666" FontSize="12" Margin="0,10,0,20" FontWeight="Bold"/>

            <!-- Settings Section -->
            <TextBlock Text="User Preferences" FontSize="14" FontWeight="Bold" Margin="0,20,0,10"/>
            <Border BorderThickness="1" BorderBrush="#DDD" Padding="0" Margin="0,0,0,20">
                <local:SettingsControl x:Name="SettingsControlHost" Height="400"/>
            </Border>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Save Configuration" 
                        Command="{Binding SaveConfigCommand}"
                        Padding="15,8" 
                        Background="#0078D4" 
                        Foreground="White" 
                        Margin="0,0,10,0"/>
                <Button Content="Edit Config in Editor" 
                        Command="{Binding EditConfigCommand}"
                        Padding="15,8" 
                        Background="#6B8E23" 
                        Foreground="White" 
                        Margin="0,0,10,0"/>
                <Button Content="Reindex Workspace" 
                        Command="{Binding ReindexCommand}"
                        Padding="15,8" 
                        Background="#7030A0" 
                        Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
