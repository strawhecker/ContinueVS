<UserControl x:Class="ContinueVS.UI.Infrastructure.DialogOverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch"
             Panel.ZIndex="999">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dimming background (semi-transparent) -->
        <Rectangle Grid.Row="0" Grid.RowSpan="3"
                   Fill="Black"
                   Opacity="0.5"
                   IsHitTestVisible="True"/>

        <!-- Dialog content area centered -->
        <ContentControl Grid.Row="1"
                        Content="{Binding MainViewModel.DialogContent}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Padding="16"/>
    </Grid>
</UserControl>
