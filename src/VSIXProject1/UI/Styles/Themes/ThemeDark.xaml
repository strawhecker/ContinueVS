<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- VSCode Dark Theme Color Palette -->

    <!-- Editor and Panel Backgrounds -->
    <SolidColorBrush x:Key="EditorBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#252526"/>
    <SolidColorBrush x:Key="CodeBackground" Color="#2D2D30"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="DockPaneBackground" Color="#252526"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#858585"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6F6F6F"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="#0E639C"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1177BB"/>
    <SolidColorBrush x:Key="ButtonActiveBrush" Color="#094771"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#007ACC"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#13C127"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#DCA81B"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F14C4C"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#007ACC"/>

    <!-- Borders and Separators -->
    <SolidColorBrush x:Key="BorderBrush" Color="#464647"/>
    <SolidColorBrush x:Key="DarkBorderBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="LightBorderBrush" Color="#555555"/>

    <!-- Selection and Highlight -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#094771"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#2D2D30"/>

    <!-- Semantic UI Colors (for specific components) -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#0E639C"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#464647"/>
    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#000000"/>

    <!-- Opacity for overlays (used via SolidColorBrush with Opacity property) -->
    <SolidColorBrush x:Key="ModalOverlayTransparent" Color="#000000" Opacity="0.5"/>

</ResourceDictionary>
