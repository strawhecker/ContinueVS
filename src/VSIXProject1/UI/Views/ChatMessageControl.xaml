<UserControl x:Class="ContinueVS.UI.Views.ChatMessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ContinueVS.ViewModels.Converters"
             xmlns:renderers="clr-namespace:ContinueVS.UI.Renderers"
             Margin="5">
    <UserControl.Resources>
        <local:RoleToAlignmentConverter x:Key="RoleToAlignmentConverter"/>
        <local:RoleToColorConverter x:Key="RoleToColorConverter"/>
        <local:RoleToVisibilityConverter x:Key="RoleToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid x:Name="MessageGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="{Binding Role, Converter={StaticResource RoleToAlignmentConverter}}" Margin="10,0">
            <Grid>
                <Border Background="{Binding Role, Converter={StaticResource RoleToColorConverter}}" CornerRadius="8" Padding="10">
                    <renderers:MarkdownBlockRenderer Content="{Binding Content}" />
                </Border>

                <!-- Copy All button (appears on hover for assistant messages, positioned upper left) -->
                <Button x:Name="CopyAllButton"
                        Height="22"
                        Padding="8,2,8,2"
                        Visibility="{Binding Role, Converter={StaticResource RoleToVisibilityConverter}}"
                        Background="#46464646"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="11"
                        ToolTip="Copy all"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="-4,-4,0,0"
                        Cursor="Hand">
                    <TextBlock Text="Copy All" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Delete button (appears on hover, positioned upper right) -->
                <Button x:Name="DeleteButton"
                        Width="28" 
                        Height="28" 
                        Padding="2"
                        Visibility="Hidden"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Delete message"
                        Command="{Binding Path=DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                        CommandParameter="{Binding Id}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-4,-4,0">
                    <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource VsBrush.WindowText}" 
                               TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
