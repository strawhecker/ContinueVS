<UserControl x:Class="ContinueVS.UI.Views.ChatMessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Right" Margin="10,0">
            <Border Background="{DynamicResource VsBrush.CommandBarGradient}" CornerRadius="8" Padding="10">
                <TextBlock Text="{Binding Content}" Foreground="{DynamicResource VsBrush.WindowText}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
