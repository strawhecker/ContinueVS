<UserControl x:Class="ContinueVS.UI.Views.TextDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400"
             MinHeight="120"
             Background="{StaticResource PanelBackground}"
             BorderBrush="{StaticResource BorderBrush}"
             BorderThickness="1"
             Padding="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Prompt Label -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Prompt, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{DynamicResource VsBrush.WindowText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <!-- Progress Bar (Progress Mode) -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,4">
            <ProgressBar x:Name="ProgressBarControl" Height="14" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,4" />
            <TextBlock x:Name="ProgressPercentLabel" Text="0%" Foreground="{DynamicResource VsBrush.WindowText}" HorizontalAlignment="Right" FontSize="11" />
        </StackPanel>

        <!-- TextBox for Text Input Mode -->
        <TextBox Grid.Row="2"
                 x:Name="InputTextBox"
                 Text="{Binding Input, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8"
                 Height="60"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource VsBrush.CommandBarGradient}"
                 Foreground="{DynamicResource VsBrush.WindowText}"
                 BorderBrush="{DynamicResource VsBrush.BrandedUIBorder}"
                 BorderThickness="1" />

        <!-- Button Stack Panel -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Height="36">
            <!-- OK Button (Text Mode) -->
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="80"
                    Margin="0,0,10,0"
                    Background="{StaticResource ButtonPrimaryBrush}"
                    Foreground="White"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Click="OkButton_Click"
                    Visibility="Visible" />

            <!-- Yes Button (Confirmation Mode) -->
            <Button x:Name="YesButton"
                    Content="Yes"
                    Width="80"
                    Margin="0,0,10,0"
                    Background="{StaticResource SuccessBrush}"
                    Foreground="White"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Click="YesButton_Click"
                    Visibility="Collapsed" />

            <!-- Cancel Button (Text Mode) -->
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="80"
                    Background="{StaticResource ErrorBrush}"
                    Foreground="White"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Click="CancelButton_Click"
                    Visibility="Visible" />

            <!-- No Button (Confirmation Mode) -->
            <Button x:Name="NoButton"
                    Content="No"
                    Width="80"
                    Background="{StaticResource WarningBrush}"
                    Foreground="White"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Click="NoButton_Click"
                    Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
