<UserControl x:Class="ContinueVS.UI.ContinueToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:local="clr-namespace:ContinueVS.UI"
             xmlns:infra="clr-namespace:ContinueVS.UI.Infrastructure"
             Background="{DynamicResource VsBrush.Window}"
             Foreground="{DynamicResource VsBrush.WindowText}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Spinner shown while the binary is starting -->
        <StackPanel Grid.Row="0" x:Name="LoadingPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock x:Name="StatusText"
                       Text="Starting Continue AI engine…"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource VsBrush.WindowText}"
                       Margin="0,0,0,8"/>
            <ProgressBar IsIndeterminate="True" Width="200" Height="6"/>
        </StackPanel>

        <!-- Frame for page navigation -->
        <Frame Grid.Row="1" x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>

        <!-- WebView2 – hidden until the binary is ready -->
        <wv2:WebView2 Grid.Row="1" x:Name="WebView"
                      Visibility="Collapsed"/>

        <!-- Tooltip Adorner Layer -->
        <infra:TooltipAdornerLayer Grid.Row="2" x:Name="TooltipLayer"
                                    Visibility="{Binding MainViewModel.IsTooltipVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

        <!-- Dialog Overlay Panel (spans all rows for positioning) -->
        <infra:DialogOverlayPanel Grid.Row="0" Grid.RowSpan="3" x:Name="DialogOverlay"
                                   Visibility="{Binding MainViewModel.IsDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
    </Grid>

</UserControl>

