<UserControl x:Class="ContinueVS.UI.Controls.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource VsBrush.CommandBarGradient}"
             Foreground="{DynamicResource VsBrush.WindowText}"
             Height="40">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Chat Button -->
        <Button Grid.Column="0"
                x:Name="ChatButton"
                Content="Chat"
                Padding="12,8"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource VsBrush.CommandBarBorder}"
                Background="Transparent"
                Foreground="{DynamicResource VsBrush.WindowText}"
                Command="{Binding NavigateCommand}"
                CommandParameter="chat"/>

        <!-- Config Button -->
        <Button Grid.Column="1"
                x:Name="ConfigButton"
                Content="Config"
                Padding="12,8"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource VsBrush.CommandBarBorder}"
                Background="Transparent"
                Foreground="{DynamicResource VsBrush.WindowText}"
                Command="{Binding NavigateCommand}"
                CommandParameter="config"/>

        <!-- History Button -->
        <Button Grid.Column="2"
                x:Name="HistoryButton"
                Content="History"
                Padding="12,8"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource VsBrush.CommandBarBorder}"
                Background="Transparent"
                Foreground="{DynamicResource VsBrush.WindowText}"
                Command="{Binding NavigateCommand}"
                CommandParameter="history"/>

        <!-- Spacer -->
        <Border Grid.Column="3"/>

        <!-- Tool Count Badge -->
        <Border Grid.Column="4"
                Background="{DynamicResource VsBrush.AccentBorder}"
                CornerRadius="4"
                Padding="8,4"
                Margin="8,0">
            <TextBlock x:Name="ToolCountLabel"
                       Text="{Binding ToolCount, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, StringFormat='Tools: {0}'}"
                       Foreground="{DynamicResource VsBrush.WindowText}"
                       FontSize="11"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>

</UserControl>
