<Window x:Class="ContinueVS.UI.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Height="180" Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        ShowInTaskbar="True">
    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="20">
        <StackPanel VerticalAlignment="Stretch">
            <TextBlock x:Name="PromptLabel" Text="Enter value:" Foreground="#333333" Margin="0,0,0,10" FontSize="14" TextWrapping="Wrap"/>
            <TextBox x:Name="InputTextBox" Height="32" Padding="8" Margin="0,0,0,20" FontSize="13" VerticalContentAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="36">
                <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,10,0" Click="OkButton_Click" 
                        Background="#0078D4" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="80" 
                        Background="#E81123" Foreground="White" FontSize="12" VerticalAlignment="Center" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
